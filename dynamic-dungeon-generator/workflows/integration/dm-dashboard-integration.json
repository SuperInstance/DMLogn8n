      "id": "get-dungeon-for-export-1",
      "name": "Get Dungeon for Export",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [860, 600]
    },
    {
      "parameters": {
        "jsCode": "// Process dungeon data for different export formats\nconst dungeon = $node[\"Get Dungeon for Export\"].json.dungeon;\nconst format = $node[\"DM Dashboard Webhook\"].json.body.format || 'json';\n\nlet exportData = {\n  id: dungeon.id,\n  exportedAt: new Date().toISOString(),\n  format: format,\n  metadata: dungeon.metadata,\n  dimensions: dungeon.dimensions,\n  statistics: dungeon.statistics\n};\n\nswitch (format) {\n  case 'json':\n    exportData.dungeon = {\n      floors: dungeon.floors.map(floor => ({\n        floor: floor.floor,\n        rooms: floor.rooms,\n        corridors: floor.corridors,\n        spawns: floor.spawns || [],\n        loot: floor.loot || [],\n        traps: floor.traps || [],\n        puzzles: floor.puzzles || [],\n        bosses: floor.bosses || []\n      }))\n    };\n    break;\n    \n  case 'dm-notes':\n    exportData.dmNotes = {\n      overview: `Dungeon Overview\\nTheme: ${dungeon.metadata.theme}\\nDifficulty: ${dungeon.metadata.difficulty}\\nFloors: ${dungeon.dimensions.floors}\\n\\nRoom Breakdown:`,\n      rooms: dungeon.floors.flatMap(floor => \n        floor.rooms.map(room => ({\n          floor: floor.floor,\n          type: room.type,\n          size: `${room.width}x${room.height}`,\n          contents: this.summarizeRoomContents(room, floor)\n        }))\n      ),\n      encounters: dungeon.floors.flatMap(floor => \n        (floor.spawns || []).map(spawn => ({\n          floor: floor.floor,\n          enemy: spawn.type,\n          count: spawn.count || 1,\n          location: `Room at (${spawn.x}, ${spawn.y})`\n        }))\n      ),\n      treasures: dungeon.floors.flatMap(floor => \n        (floor.loot || []).map(loot => ({\n          floor: floor.floor,\n          type: loot.type,\n          value: loot.value || 'unknown',\n          location: `Room at (${loot.x}, ${loot.y})`\n        }))\n      )\n    };\n    break;\n    \n  case 'player-map':\n    exportData.playerMap = {\n      theme: dungeon.metadata.theme,\n      difficulty: dungeon.metadata.difficulty,\n      floors: dungeon.floors.map(floor => ({\n        floor: floor.floor,\n        rooms: floor.rooms.map(room => ({\n          id: room.id,\n          type: room.type === 'secret' ? 'unknown' : room.type,\n          x: room.x,\n          y: room.y,\n          width: room.width,\n          height: room.height,\n          discovered: false,\n          notes: room.type === 'entrance' ? 'Entrance' : ''\n        })),\n        corridors: floor.corridors.map(corridor => ({\n          id: corridor.id,\n          path: corridor.path,\n          discovered: false\n        }))\n      }))\n    };\n    break;\n    \n  default:\n    exportData.error = `Unsupported format: ${format}`;\n}\n\nfunction summarizeRoomContents(room, floor) {\n  const contents = [];\n  \n  // Find enemies in this room\n  const enemies = (floor.spawns || []).filter(spawn => \n    spawn.x >= room.x && spawn.x < room.x + room.width &&\n    spawn.y >= room.y && spawn.y < room.y + room.height\n  );\n  \n  if (enemies.length > 0) {\n    contents.push(`${enemies.length} enemies`);\n  }\n  \n  // Find loot in this room\n  const loot = (floor.loot || []).filter(item => \n    item.x >= room.x && item.x < room.x + room.width &&\n    item.y >= room.y && item.y < room.y + room.height\n  );\n  \n  if (loot.length > 0) {\n    contents.push(`${loot.length} loot items`);\n  }\n  \n  // Find traps in this room\n  const traps = (floor.traps || []).filter(trap => \n    trap.x >= room.x && trap.x < room.x + room.width &&\n    trap.y >= room.y && trap.y < room.y + room.height\n  );\n  \n  if (traps.length > 0) {\n    contents.push(`${traps.length} traps`);\n  }\n  \n  return contents.length > 0 ? contents.join(', ') : 'Empty';\n}\n\nreturn { json: exportData };"
      },
