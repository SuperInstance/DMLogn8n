# Server Configuration
NODE_ENV=development
PORT=3001

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/dmlogn8n-recommendations

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info

# Performance Configuration
CACHE_TTL=3600
MAX_CACHE_SIZE=500MB
CLEANUP_INTERVAL=300000

# Recommendation Engine Configuration
MIN_INTERACTIONS_FOR_COLLABORATIVE=5
SIMILARITY_THRESHOLD=0.1
MAX_NEIGHBORS=50
FEATURE_WEIGHT_THRESHOLD=0.01

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Behavior Tracking
BEHAVIOR_RATE_LIMIT_WINDOW_MS=60000
BEHAVIOR_RATE_LIMIT_MAX_REQUESTS=200

# Model Training
MODEL_RETRAIN_INTERVAL=86400000
BATCH_SIZE=32
LEARNING_RATE=0.001

# Analytics
ENABLE_ANALYTICS=true
METRICS_RETENTION_DAYS=30

# External Services
WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Email Configuration (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Monitoring
ENABLE_HEALTH_CHECK=true
HEALTH_CHECK_INTERVAL=30000