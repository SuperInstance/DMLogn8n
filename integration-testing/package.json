{
  "name": "dmlogn8n-integration-testing",
  "version": "1.0.0",
  "description": "Comprehensive Integration Testing Suite for DMlogn8n - End-to-end, performance, and scenario testing for all systems",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "test:e2e": "jest --testPathPattern=tests/e2e --runInBand",
    "test:performance": "jest --testPathPattern=tests/performance --runInBand",
    "test:scenarios": "jest --testPathPattern=tests/scenarios --runInBand",
    "test:integration": "jest --testPathPattern=tests/integration --runInBand",
    "test:all": "npm run test:integration && npm run test:e2e && npm run test:performance && npm run test:scenarios",
    "test:coverage": "jest --coverage --runInBand",
    "test:report": "npm run test:coverage && npm run generate:reports",
    "generate:reports": "node scripts/generate-reports.js",
    "mock:servers": "node scripts/start-mock-servers.js",
    "setup:environment": "node scripts/setup-test-environment.js",
    "cleanup:environment": "node scripts/cleanup-test-environment.js",
    "benchmark": "node scripts/run-benchmarks.js",
    "lint": "eslint src/**/*.js tests/**/*.js",
    "lint:fix": "eslint src/**/*.js tests/**/*.js --fix",
    "validate:fixtures": "node scripts/validate-fixtures.js",
    "load:fixtures": "node scripts/load-test-fixtures.js"
  },
  "keywords": [
    "integration-testing",
    "e2e-testing",
    "performance-testing",
    "dnd",
    "dmlogn8n",
    "testing-framework",
    "automation",
    "jest",
    "supertest",
    "benchmarks"
  ],
  "author": "DMlogn8n Testing Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2",
    "supertest": "^6.3.3",
    "axios": "^1.5.0",
    "ws": "^8.13.0",
    "mongoose": "^7.5.0",
    "redis": "^4.6.7",
    "mongodb": "^5.7.0",
    "pg": "^8.11.3",
    "bull": "^4.11.3",
    "ioredis": "^5.3.2",
    "uuid": "^9.0.0",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "faker": "^5.5.3",
    "@faker-js/faker": "^7.6.0",
    "chance": "^1.1.11",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "winston": "^3.10.0",
    "dotenv": "^16.3.1",
    "joi": "^17.9.2",
    "yargs": "^17.7.2",
    "chalk": "^4.1.2",
    "ora": "^5.4.1",
    "inquirer": "^8.2.6",
    "table": "^6.8.1",
    "cli-progress": "^3.12.0",
    "benchmark": "^2.1.4",
    "autocannon": "^7.12.0",
    "clinic": "^12.1.0",
    "artillery": "^2.0.0",
    "k6": "^0.45.0",
    "puppeteer": "^21.1.1",
    "playwright": "^1.37.1",
    "selenium-webdriver": "^4.11.1",
    "webdriverio": "^8.16.4",
    "cucumber": "^8.10.0",
    "cucumber-html-reporter": "^6.0.0",
    "multiple-cucumber-html-reporter": "^3.4.0",
    "jest-html-reporters": "^3.1.4",
    "jest-stare": "^2.3.0",
    "jest-allure": "^0.1.3",
    "allure-commandline": "^2.22.1",
    "testcafe": "^3.0.1",
    "cypress": "^12.17.4",
    "newman": "^6.0.0",
    "postman-collection": "^4.1.0",
    "js-yaml": "^4.1.0",
    "ajv": "^8.12.0",
    "jsonschema": "^1.4.1",
    "tv4": "^1.3.0",
    "chai": "^4.3.8",
    "chai-as-promised": "^7.1.1",
    "chai-http": "^4.4.0",
    "sinon": "^15.2.0",
    "sinon-chai": "^3.7.0",
    "nock": "^13.3.2",
    "mock-fs": "^5.2.0",
    "proxyquire": "^2.1.3",
    "rewire": "^6.0.0",
    "testdouble": "^3.16.7",
    "node-mocks-http": "^1.12.2",
    "mock-socket": "^9.3.1",
    "mock-redis-client": "^0.6.0",
    "mongodb-memory-server": "^8.14.0",
    "redis-memory-server": "^0.10.0",
    "tmp": "^0.2.1",
    "rimraf": "^5.0.1",
    "mkdirp": "^3.0.1",
    "fs-extra": "^11.1.1",
    "csv-parser": "^3.0.0",
    "csv-writer": "^1.6.0",
    "xlsx": "^0.18.5",
    "pdf2json": "^3.0.5",
    "sharp": "^0.32.4",
    "jimp": "^0.22.10",
    "canvas": "^2.11.2",
    "plotly": "^1.0.6",
    "chart.js": "^4.4.0",
    "d3": "^7.8.5",
    "express-rate-limit": "^6.8.1",
    "express-validator": "^7.0.1",
    "multer": "^1.4.5",
    "form-data": "^4.0.0",
    "node-fetch": "^2.7.0",
    "cross-fetch": "^3.1.8",
    "eventsource": "^2.0.2",
    "sse": "^0.1.0",
    "mqtt": "^5.0.0",
    "amqplib": "^0.10.3",
    "kafka-node": "^5.0.0",
    "nats": "^2.14.0"
  },
  "devDependencies": {
    "jest": "^29.6.2",
    "jest-environment-node": "^29.6.2",
    "@types/jest": "^29.5.5",
    "ts-jest": "^29.1.1",
    "eslint": "^8.47.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "prettier": "^3.0.2",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.3",
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.0",
    "npm-run-all": "^4.1.5",
    "cross-env": "^7.0.3",
    "nyc": "^15.1.0",
    "codecov": "^3.8.3",
    "coveralls": "^3.1.1",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "@commitlint/cli": "^17.7.1",
    "@commitlint/config-conventional": "^17.7.0",
    "semantic-release": "^21.1.1",
    "standard-version": "^9.5.0",
    "release-it": "^16.1.5",
    "simple-git": "^3.19.1",
    "git-rev-sync": "^3.0.2",
    "git-changelog": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/?(*.)+(spec|test).js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/index.js",
      "!**/node_modules/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html",
      "json",
      "clover"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "globalSetup": "<rootDir>/tests/global-setup.js",
    "globalTeardown": "<rootDir>/tests/global-teardown.js",
    "testTimeout": 60000,
    "maxWorkers": 1,
    "verbose": true,
    "bail": false,
    "reporters": [
      "default",
      "jest-html-reporters",
      [
        "jest-stare",
        {
          "resultDir": "reports/jest-stare",
          "coverageLink": "../coverage/lcov-report/index.html"
        }
      ]
    ],
    "projects": [
      {
        "displayName": "Integration Tests",
        "testMatch": [
          "<rootDir>/tests/integration/**/*.test.js"
        ],
        "testTimeout": 30000
      },
      {
        "displayName": "E2E Tests",
        "testMatch": [
          "<rootDir>/tests/e2e/**/*.test.js"
        ],
        "testTimeout": 120000
      },
      {
        "displayName": "Performance Tests",
        "testMatch": [
          "<rootDir>/tests/performance/**/*.test.js"
        ],
        "testTimeout": 300000
      },
      {
        "displayName": "Scenario Tests",
        "testMatch": [
          "<rootDir>/tests/scenarios/**/*.test.js"
        ],
        "testTimeout": 600000
      }
    ]
  },
  "nyc": {
    "reporter": [
      "text",
      "html",
      "lcov",
      "json"
    ],
    "exclude": [
      "**/tests/**",
      "**/node_modules/**",
      "**/coverage/**"
    ],
    "check-coverage": true,
    "lines": 80,
    "functions": 80,
    "branches": 80,
    "statements": 80
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm run test:all",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write",
      "git add"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dmlogn8n/integration-testing.git"
  },
  "bugs": {
    "url": "https://github.com/dmlogn8n/integration-testing/issues"
  },
  "homepage": "https://dmlogn8n.com/integration-testing"
}