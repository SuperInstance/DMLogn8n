# Environment Variables for D&D 5e Rule Engine

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (when implemented)
DATABASE_URL=mongodb://localhost:27017/dnd5e-ruleengine
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info
LOG_FILE=logs/rule-engine.log

# Security
JWT_SECRET=your-secret-key-here
CORS_ORIGIN=http://localhost:3000

# Feature Flags
ENABLE_METRICS=true
ENABLE_CACHE=true
ENABLE_WEBSOCKETS=true

# Performance
MAX_CONCURRENT_COMBATS=100
CACHE_TTL=3600
REQUEST_TIMEOUT=30000

# Development Settings
DEBUG_API=true
ENABLE_SWAGGER=true
ENABLE_PROFILER=false