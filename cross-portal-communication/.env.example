# Server Configuration
PORT=3001
HOST=localhost
WS_PORT=3002
WS_HEARTBEAT_INTERVAL=30000
WS_MAX_CONNECTIONS=1000

# Database Configuration
DATABASE_URI=mongodb://localhost:27017/cross-portal-comm

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Security Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=24h
BCRYPT_ROUNDS=12
ENCRYPTION_KEY=your-32-character-encryption-key-123456
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Message Configuration
MAX_MESSAGE_SIZE=1048576
MESSAGE_HISTORY_LIMIT=100
PRIORITY_QUEUE_SIZE=10000
BROADCAST_MAX_TARGETS=500

# Portal Configuration
DM_PORTAL_URL=http://localhost:3000
PLAYER_PORTAL_URL=http://localhost:3001
CODER_PORTAL_URL=http://localhost:3002
COMBAT_PORTAL_URL=http://localhost:3003
CHARACTER_PORTAL_URL=http://localhost:3004

# Portal API Keys
DM_PORTAL_API_KEY=dm-api-key
PLAYER_PORTAL_API_KEY=player-api-key
CODER_PORTAL_API_KEY=coder-api-key
COMBAT_PORTAL_API_KEY=combat-api-key
CHARACTER_PORTAL_API_KEY=character-api-key

# Portal Webhook Secrets
DM-PORTAL_WEBHOOK_SECRET=dm-webhook-secret
PLAYER-PORTAL_WEBHOOK_SECRET=player-webhook-secret
CODER-PORTAL_WEBHOOK_SECRET=coder-webhook-secret
COMBAT-PORTAL_WEBHOOK_SECRET=combat-webhook-secret
CHARACTER-PORTAL_WEBHOOK_SECRET=character-webhook-secret

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/cross-portal-comm.log
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14

# Performance Configuration
COMPRESSION_LEVEL=6
CACHE_TIMEOUT=300000
SYNC_INTERVAL=5000

# Environment
NODE_ENV=development