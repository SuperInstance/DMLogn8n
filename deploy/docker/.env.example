# DMLogn8n Environment Configuration
# Copy this file to .env and update the values

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
TZ=UTC

# Database Configuration
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_DATABASE=dmlogn8n
MYSQL_USER=dmlogn8n_user
MYSQL_PASSWORD=your_secure_db_password_here

# N8N Configuration
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=your_secure_n8n_password_here
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=your_32_character_encryption_key_here
N8N_JWT_SECRET=your_32_character_jwt_secret_here

# Additional Database Configuration
DB_MYSQLDB_DATABASE=n8n
DB_MYSQLDB_USER=n8n_user
DB_MYSQLDB_PASSWORD=your_secure_n8n_db_password_here
QUEUE_BULL_REDIS_PASSWORD=

# API Configuration
API_SECRET_KEY=your_32_character_api_secret_key_here
API_JWT_SECRET_KEY=your_32_character_jwt_secret_key_here
CORS_ORIGINS=*
RATE_LIMIT=100/hour

# Character Coder Configuration
CHARACTER_CODER_SECRET_KEY=your_32_character_character_secret_key_here
CHARACTER_MODEL=gpt-4
CHARACTER_TEMPERATURE=0.7
CHARACTER_MAX_TOKENS=1000

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8000
REACT_APP_N8N_URL=http://localhost:5678
REACT_APP_WS_URL=ws://localhost:8000
REACT_APP_ENVIRONMENT=development
REACT_APP_VERSION=1.0.0

# Feature Flags
REACT_APP_FEATURES_CHARACTER_CODE=true
REACT_APP_FEATURES_VOICE_CHAT=true
REACT_APP_FEATURES_REAL_TIME_COMBAT=true

# Grafana Configuration
GRAFANA_USER=admin
GRAFANA_PASSWORD=your_secure_grafana_password_here