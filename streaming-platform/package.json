{
  "name": "dnd-streaming-platform",
  "version": "1.0.0",
  "description": "Professional streaming platform for D&D sessions with multi-platform integration",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "obs-build": "cd obs-plugin && cmake -S . -B build && cmake --build build",
    "stream-deck-build": "cd stream-deck-plugin && npm run build",
    "docker:build": "docker build -t dnd-streaming-platform .",
    "docker:run": "docker run -p 3000:3000 dnd-streaming-platform"
  },
  "keywords": ["dnd", "streaming", "obs", "twitch", "youtube", "gaming"],
  "author": "DMlogn8n Streaming Platform",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "ws": "^8.14.2",
    "node-cron": "^3.0.2",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.2",
    "axios": "^1.5.1",
    "dotenv": "^16.3.1",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1",
    "mongoose": "^7.6.3",
    "redis": "^4.6.10",
    "bull": "^4.11.3",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.32.6",
    "canvas": "^2.11.2",
    "tmi.js": "^1.8.5",
    "youtube-api": "^3.0.3",
    "googleapis": "^126.0.1",
    "patreon-api": "^0.3.0",
    "stripe": "^13.10.0",
    "paypal-rest-sdk": "^1.8.1",
    "openai": "^4.14.2",
    "replicate": "^0.22.0",
    "puppeteer": "^21.3.8",
    "cheerio": "^1.0.0-rc.12",
    "rss-parser": "^3.13.0",
    "node-telegram-bot-api": "^0.63.0",
    "twitter-api-v2": "^1.15.0",
    "instagram-api": "^1.0.3",
    "tiktok-api": "^0.1.2",
    "facebook-graph-api": "^1.0.1",
    "obs-websocket-js": "^5.0.3",
    "elgato-stream-deck": "^5.8.0"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "@types/express": "^4.17.20",
    "@types/ws": "^8.5.7",
    "@types/bcrypt": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.4",
    "@types/multer": "^1.4.9",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/jest": "^29.5.6",
    "typescript": "^5.2.2",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "@types/node-cron": "^3.0.11",
    "eslint": "^8.51.0",
    "@typescript-eslint/eslint-plugin": "^6.9.0",
    "@typescript-eslint/parser": "^6.9.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}