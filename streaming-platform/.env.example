# Server Configuration
PORT=3000
NODE_ENV=development
API_KEY=your-api-key-here

# Database
MONGODB_URI=mongodb://localhost:27017/dnd-streaming-platform
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=7d

# OBS Studio
OBS_WEBSOCKET_URL=ws://localhost:4444
OBS_WEBSOCKET_PASSWORD=your-obs-password

# Twitch API
TWITCH_CLIENT_ID=your-twitch-client-id
TWITCH_CLIENT_SECRET=your-twitch-client-secret
TWITCH_BROADCASTER_ID=your-twitch-broadcaster-id

# YouTube API
YOUTUBE_API_KEY=your-youtube-api-key
YOUTUBE_CLIENT_ID=your-youtube-client-id
YOUTUBE_CLIENT_SECRET=your-youtube-client-secret
YOUTUBE_CHANNEL_ID=your-youtube-channel-id

# Facebook Gaming
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_PAGE_ID=your-facebook-page-id

# TikTok
TIKTOK_CLIENT_ID=your-tiktok-client-id
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# OpenAI (for AI features)
OPENAI_API_KEY=your-openai-api-key

# Replicate (for AI thumbnails)
REPLICATE_API_TOKEN=your-replicate-api-token

# Stripe (Payments)
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# PayPal
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox

# Patreon
PATREON_CLIENT_ID=your-patreon-client-id
PATREON_CLIENT_SECRET=your-patreon-client-secret
PATREON_ACCESS_TOKEN=your-patreon-access-token

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Twitter/X
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_TOKEN_SECRET=your-twitter-access-token-secret

# Instagram
INSTAGRAM_CLIENT_ID=your-instagram-client-id
INSTAGRAM_CLIENT_SECRET=your-instagram-client-secret
INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=50MB

# RTMP Configuration
RTMP_SERVER_URL=rtmp://your-rtmp-server.com/live
RTMP_STREAM_KEY=your-rtmp-stream-key

# Analytics
GOOGLE_ANALYTICS_ID=your-google-analytics-id

# Custom Overlays
OVERLAY_SERVER_URL=http://localhost:3001