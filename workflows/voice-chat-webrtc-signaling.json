{
  "name": "Voice Chat Integration - WebRTC Signaling",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "voice/webrtc-signaling",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webrtc-webhook",
      "name": "WebRTC Signaling Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "voice-webrtc-signaling"
    },
    {
      "parameters": {
        "jsCode": "// Parse WebRTC signaling message\nconst message = $input.first().json;\nconst { type, sessionId, userId, data } = message;\n\n// Validate required fields\nif (!type || !sessionId || !userId) {\n  throw new Error('Missing required fields: type, sessionId, userId');\n}\n\n// Validate message type\nconst validTypes = ['offer', 'answer', 'ice-candidate', 'join', 'leave', 'session-config'];\nif (!validTypes.includes(type)) {\n  throw new Error(`Invalid message type: ${type}`);\n}\n\n// Process message based on type\nlet processedData = {\n  timestamp: new Date().toISOString(),\n  type,\n  sessionId,\n  userId,\n  data: data || {}\n};\n\n// Add session metadata\nif (type === 'join') {\n  processedData.sessionConfig = {\n    maxParticipants: 6,\n    audioConstraints: {\n      echoCancellation: true,\n      noiseSuppression: true,\n      autoGainControl: true,\n      sampleRate: 48000\n    },\n    videoConstraints: {\n      width: { min: 640, ideal: 1280 },\n      height: { min: 480, ideal: 720 },\n      frameRate: { min: 15, ideal: 30 }\n    }\n  };\n}\n\nreturn { json: processedData };"
      },
      "id": "parse-signaling",
      "name": "Parse Signaling Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {\n          "options": {\n            "caseSensitive": true,\n            "leftValue": "",\n            "typeValidation": "strict"\n          },\n          "conditions": [\n            {\n              "id": "join-condition",\n              "leftValue": "={{ $json.type }}",\n              "rightValue": "join",\n              "operator": {\n                "type": "string",\n                "operation": "equals"\n              }\n            },\n            {\n              "id": "offer-condition",\n              "leftValue": "={{ $json.type }}",\n              "rightValue": "offer",\n              "operator": {\n                "type": "string",\n                "operation": "equals"\n              }\n            },\n            {\n              "id": "answer-condition",\n              "leftValue": "={{ $json.type }}",\n              "rightValue": "answer",\n              "operator": {\n                "type": "string",\n                "operation": "equals"\n              }\n            },\n            {\n              "id": "ice-condition",\n              "leftValue": "={{ $json.type }}",\n              "rightValue": "ice-candidate",\n              "operator": {\n                "type": "string",\n                "operation": "equals"\n              }\n            },\n            {\n              "id": "leave-condition",\n              "leftValue": "={{ $json.type }}",\n              "rightValue": "leave",\n              "operator": {\n                "type": "string",\n                "operation": "equals"\n              }\n            }\n          ],\n          "combinator": "and"\n        }\n      },\n      "id": "route-message-type",\n      "name": "Route by Message Type",\n      "type": "n8n-nodes-base.switch",\n      "typeVersion": 2,\n      "position": [680, 300]\n    },\n    {\n      "parameters": {\n        "operation": "create",\n        "documentId": "={{ $json.sessionId }}",\n        "fieldsUi": {\n          "fieldValues": [\n            {\n              "fieldName": "sessionId",\n              "fieldValue": "={{ $json.sessionId }}"\n            },\n            {\n              "fieldName": "participants",\n              "fieldValue": "={{ [ $json.userId ] }}"\n            },\n            {\n              "fieldName": "createdAt",\n              "fieldValue": "={{ $json.timestamp }}"\n            },\n            {\n              "fieldName": "status",\n              "fieldValue": "active"\n            },\n            {\n              "fieldName": "config",\n              "fieldValue": "={{ $json.sessionConfig }}"\n            }\n          ]\n        }\n      },\n      "id": "create-session",\n      "name": "Create Voice Session",\n      "type": "n8n-nodes-base.googleFirestore",\n      "typeVersion": 1,\n      "position": [920, 180]\n    },\n    {\n      "parameters": {\n        "operation": "update",\n        "documentId": "={{ $json.sessionId }}",\n        "fieldsUi": {\n          "fieldValues": [\n            {\n              "fieldName": "participants",\n              "fieldValue": "={{ $json.data.offer }}"\n            },\n            {\n              "fieldName": "lastActivity",\n              "fieldValue": "={{ $json.timestamp }}"\n            }\n          ]\n        }\n      },\n      "id": "handle-offer",\n      "name": "Handle Offer",\n      "type": "n8n-nodes-base.googleFirestore",\n      "typeVersion": 1,\n      "position": [920, 260]\n    },\n    {\n      "parameters": {\n        "operation": "update",\n        "documentId": "={{ $json.sessionId }}",\n        "fieldsUi": {\n          "fieldValues": [\n            {\n              "fieldName": "participants",\n              "fieldValue": "={{ $json.data.answer }}"\n            },\n            {\n              "fieldName": "lastActivity",\n              "fieldValue": "={{ $json.timestamp }}"\n            }\n          ]\n        }\n      },\n      "id": "handle-answer",\n      "name": "Handle Answer",\n      "type": "n8n-nodes-base.googleFirestore",\n      "typeVersion": 1,\n      "position": [920, 340]\n    },\n    {\n      "parameters": {\n        "operation": "update",\n        "documentId": "={{ $json.sessionId }}",\n        "fieldsUi": {\n          "fieldValues": [\n            {\n              "fieldName": "iceCandidates",\n              "fieldValue": "={{ $json.data.candidate }}"\n            },\n            {\n              "fieldName": "lastActivity",\n              "fieldValue": "={{ $json.timestamp }}"\n            }\n          ]\n        }\n      },\n      "id": "handle-ice-candidate",\n      "name": "Handle ICE Candidate",\n      "type": "n8n-nodes-base.googleFirestore",\n      "typeVersion": 1,\n      "position": [920, 420]\n    },\n    {\n      "parameters": {\n        "operation": "update",\n        "documentId": "={{ $json.sessionId }}",\n        "fieldsUi": {\n          "fieldValues": [\n            {\n              "fieldName": "participants",\n              "fieldValue": "={{ $json.participants.filter(p => p !== $json.userId) }}"\n            },\n            {\n              "fieldName": "lastActivity",\n              "fieldValue": "={{ $json.timestamp }}"\n            },\n            {\n              "fieldName": "status",\n              "fieldValue": "={{ $json.participants.length <= 1 ? 'inactive' : 'active' }}"\n            }\n          ]\n        }\n      },\n      "id": "handle-leave",\n      "name": "Handle Leave",\n      "type": "n8n-nodes-base.googleFirestore",\n      "typeVersion": 1,\n      "position": [920, 500]\n    },\n    {\n      "parameters": {\n        "jsCode": "// Broadcast message to session participants\nconst message = $input.first().json;\nconst { sessionId, userId, type } = message;\n\n// Get current session participants\nconst sessionDoc = await $getGoogleFirestoreItem('voice_sessions', sessionId);\nconst participants = sessionDoc?.participants || [];\n\n// Prepare broadcast message\nconst broadcastMessage = {\n  ...message,\n  broadcastTime: new Date().toISOString(),\n  recipientCount: participants.length - 1 // Exclude sender\n};\n\n// Send WebSocket broadcast to each participant\nconst broadcasts = participants\n  .filter(participantId => participantId !== userId)\n  .map(participantId => ({\n    endpoint: `/voice/session/${sessionId}/participant/${participantId}`,\n    message: broadcastMessage\n  }));\n\nreturn broadcasts.map(broadcast => ({ json: broadcast }));"
      },\n      "id": "broadcast-to-participants",\n      "name": "Broadcast to Participants",\n      "type": "n8n-nodes-base.code",\n      "typeVersion": 2,\n      "position": [1140, 300]\n    },\n    {\n      "parameters": {\n        "url": "={{ $json.endpoint }}",\n        "sendHeaders": true,\n        "headerParameters": {\n          "parameters": [\n            {\n              "name": "Content-Type",\n              "value": "application/json"\n            },\n            {\n              "name": "X-Session-ID",\n              "value": "={{ $json.message.sessionId }}"\n            }\n          ]\n        },\n        "sendBody": true,\n        "bodyParameters": {\n          "parameters": [\n            {\n              "name": "message",\n              "value": "={{ $json.message }}"\n            }\n          ]\n        },\n        "options": {\n          "timeout": 5000\n        }\n      },\n      "id": "send-websocket-broadcast",\n      "name": "Send WebSocket Broadcast",\n      "type": "n8n-nodes-base.httpRequest",\n      "typeVersion": 3,\n      "position": [1360, 300]\n    },\n    {\n      "parameters": {\n        "respondWith": "json",\n        "responseBody": "={{ { success: true, message: 'Signaling message processed', sessionId: $json.sessionId, timestamp: new Date().toISOString() } }}"\n      },\n      "id": "respond-to-webhook",\n      "name": "Respond to Webhook",\n      "type": "n8n-nodes-base.respondToWebhook",\n      "typeVersion": 1,\n      "position": [1580, 300]\n    }\n  ],\n  "connections": {\n    "WebRTC Signaling Webhook": {\n      "main": [\n        [\n          {\n            "node": "Parse Signaling Message",\n            "type": "main",\n            "index": 0\n          }\n        ]\n      ]\n    },\n    "Parse Signaling Message": {\n      "main": [\n        [\n          {\n            "node": "Route by Message Type",\n            "type": "main",\n            "index": 0\n          }\n        ]\n      ]\n    },\n    "Route by Message Type": {\n      "main": [\n        [\n          {\n            "node": "Create Voice Session",\n            "type": "main",\n            "index": 0\n          }\n        ],\n        [\n          {\n            "node": "Handle Offer",\n            "type": "main",\n            "index": 0\n          }\n        ],\n        [\n          {\n            "node": "Handle Answer",\n            "type": "main",\n            "index": 0\n          }\n        ],\n        [\n          {\n            "node": "Handle ICE Candidate",\n            "type": "main",\n            "index": 0\n          }\n        ],\n        [\n          {\n            "node": "Handle Leave",\n            "type": "main",\n            "index": 0\n          }\n        ]\n      ]\n    },\n    "Create Voice Session": {\n      "main": [\n        [\n          {\n            "node": "Broadcast to Participants",\n            "type": "main",\n            "index": 0\n          }\n        ]\n      ]\n    },\n    "Handle Offer": {\n      "main": [\n        [\n          {\n            "node": "Broadcast to Participants",\n            "type": "main",\n            "index": 0\n          }\n        ]\n      ]\n    },\n    "Handle Answer": {\n      "main": [\n        [\n          {\n            "node": "Broadcast to Participants",\n            "type": "main",\n            "index": 0\n          }\n        ]\n      ]\n    },\n    "Handle ICE Candidate": {\n      "main": [\n        [\n          {\n            "node": "Broadcast to Participants",\n            "type": "main",\n            "index": 0\n          }\n        ]\n      ]\n    },\n    "Handle Leave": {\n      "main": [\n        [\n          {\n            "node": "Broadcast to Participants",\n            "type": "main",\n            "index": 0\n          }\n        ]\n      ]\n    },\n    "Broadcast to Participants": {\n      "main": [\n        [\n          {\n            "node": "Send WebSocket Broadcast",\n            "type": "main",\n            "index": 0\n          }\n        ]\n      ]\n    },\n    "Send WebSocket Broadcast": {\n      "main": [\n        [\n          {\n            "node": "Respond to Webhook",\n            "type": "main",\n            "index": 0\n          }\n        ]\n      ]\n    }\n  },\n  "settings": {\n    "timezone": "America/New_York",\n    "saveManualExecutions": true,\n    "callerPolicyDefaultOption": "workflowsFromSameOwner"\n  },\n  "staticData": null,\n  "tags": [\n    {\n      "id": "voice-chat",\n      "name": "Voice Chat"\n    },\n    {\n      "id": "webrtc",\n      "name": "WebRTC"\n    },\n    {\n      "id": "real-time",\n      "name": "Real-Time"\n    }\n  ],\n  "triggerCount": 0,\n  "updatedAt": "2025-01-23T10:00:00.000Z",\n  "versionId": "1"\n}