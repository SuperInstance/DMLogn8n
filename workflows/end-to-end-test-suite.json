        "respondWith": "json",
        "responseBody": "={{ $json }}"
      },
      "id": "return-test-report",
      "name": "Return Test Report",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [2220, 400]
    },
    {
      "parameters": {\n        "conditions": {\n          "options": {\n            "caseSensitive": true,\n            "leftValue": "",\n            "typeValidation": "strict"\n          },\n          "conditions": [\n            {\n              "id": "error-condition",\n              "leftValue": "={{ $json.status }}",\n              "rightValue": "error",\n              "operator": {\n                "type": "string",\n                "operation": "equals"\n              }\n            }\n          ],\n          "combinator": "and"\n        }\n      },\n      "id": "error-handler-router",\n      "name": "Error Handler Router",\n      "type": "n8n-nodes-base.if",\n      "typeVersion": 2,\n      "position": [1340, 800]\n    },\n    {\n      "parameters": {\n        "jsCode": "// Handle test failures and generate error reports\nconst errorReport = {\n  testSuite: 'end_to_end',\n  sessionId: $json.sessionId,\n  errorType: $json.errorType || 'unknown',\n  errorMessage: $json.errorMessage || 'Unknown error occurred',\n  failedStep: $json.failedStep || 'unknown',\n  timestamp: new Date().toISOString(),\n  context: {\n    lastSuccessfulStep: $json.lastSuccessfulStep,\n    testProgress: $json.testProgress,\n    systemState: $json.systemState\n  }\n};\n\nreturn [{\n  json: {\n    ...errorReport,\n    status: 'failed',\n    errorReport: true\n  }\n}];"
      },
      "id": "handle-test-failure",
      "name": "Handle Test Failure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
n      "position": [1560, 800]\n    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseCode": 500
        }
      },
      "id": "return-error-response",
      "name": "Return Error Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1780, 800]\n    }
  ],
