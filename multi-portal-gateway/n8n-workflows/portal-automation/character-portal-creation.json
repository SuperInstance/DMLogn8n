{
  "name": "Character Portal Creation Automation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "character-portal-request",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook - Portal Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "character-portal-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-1",
              "leftValue": "={{ $json.body.character_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists"
              }
            },
            {
              "id": "condition-2",
              "leftValue": "={{ $json.body.action }}",
              "rightValue": "create",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "validate-request",
      "name": "Validate Request",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:8000/portals/character",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "character_id",
              "value": "={{ $json.body.character_id }}"
            }
          ]
        },
        "options": {}
      },
      "id": "create-portal-api",
      "name": "Create Portal API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [680, 200]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "portal_id",
              "value": "={{ $json.data.portal.id }}"
            },
            {
              "name": "character_id",
              "value": "={{ $json.body.character_id }}"
            },
            {
              "name": "status",
              "value": "creating"
            },
            {
              "name": "created_at",
              "value": "={{ $now }}"
            }
          ]
        },
        "options": {}
      },
      "id": "set-creation-data",
      "name": "Set Creation Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [900, 200]
    },
    {
      "parameters": {
        "command": "docker-compose -f /home/activeloguser/DMlogn8n/multi-portal-gateway/docker-compose.yml up -d character-portal-{{ $json.character_id }}",
        "cwd": "/home/activeloguser/DMlogn8n/multi-portal-gateway"
      },
      "id": "start-container",
      "name": "Start Character Container",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1120, 200]
    },
    {
      "parameters": {
        "url": "http://localhost:8000/portals/{{ $json.portal_id }}/status",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "check-status",
      "name": "Check Portal Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1340, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-active",
              "leftValue": "={{ $json.data.status }}",
              "rightValue": "active",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "verify-active",
      "name": "Verify Portal Active",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1560, 200]
    },
    {
      "parameters": {
        "url": "http://localhost:8000/bridge/broadcast",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "event_type",
              "value": "character_portal_created"
            },
            {
              "name": "data",
              "value": "={{ { portal_id: $json.portal_id, character_id: $json.character_id, status: 'active' } }}"
            }
          ]
        },
        "options": {}
      },
      "id": "notify-success",
      "name": "Notify Success",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1780, 200]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "status",
              "value": "completed"
            },
            {
              "name": "message",
              "value": "Character portal created successfully"
            },
            {
              "name": "portal_id",
              "value": "={{ $json.portal_id }}"
            },
            {
              "name": "character_id",
              "value": "={{ $json.character_id }}"
            }
          ]
        },
        "options": {}
      },
      "id": "success-response",
      "name": "Success Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [2000, 200]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "status",
              "value": "error"
            },
            {
              "name": "message",
              "value": "Portal activation failed"
            },
            {
              "name": "portal_id",
              "value": "={{ $json.portal_id }}"
            }
          ]
        },
        "options": {}
      },
      "id": "error-response",
      "name": "Error Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [1780, 380]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      },
      "id": "webhook-response",
      "name": "Webhook Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [2220, 200]
    }
  ],
  "connections": {
    "Webhook - Portal Request": {
      "main": [
        [
          {
            "node": "Validate Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Request": {
      "main": [
        [
          {
            "node": "Create Portal API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Portal API": {
      "main": [
        [
          {
            "node": "Set Creation Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Creation Data": {
      "main": [
        [
          {
            "node": "Start Character Container",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Start Character Container": {
      "main": [
        [
          {
            "node": "Check Portal Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Portal Status": {
      "main": [
        [
          {
            "node": "Verify Portal Active",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify Portal Active": {
      "main": [
        [
          {
            "node": "Notify Success",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Error Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notify Success": {
      "main": [
        [
          {
            "node": "Success Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Success Response": {
      "main": [
        [
          {
            "node": "Webhook Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Error Response": {
      "main": [
        [
          {
            "node": "Webhook Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "versionId": "1"
}