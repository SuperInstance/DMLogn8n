      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "// Parse and validate the character action event\nconst eventData = $json;\n\n// Extract event details\nconst event = {\n  event_id: eventData.id || `evt_${Date.now()}`,\n  character_id: eventData.character_id,\n  action_type: eventData.action_type,\n  action_data: eventData.data || {},\n  source_portal: eventData.source_portal,\n  timestamp: eventData.timestamp || new Date().toISOString(),\n  processed: false\n};\n\n// Validate required fields\nif (!event.character_id || !event.action_type) {\n  throw new Error('Missing required fields: character_id and action_type');\n}\n\nreturn { json: event };"
      },
      "id": "parse-action-event",
      "name": "Parse Action Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "combat-action",
              "leftValue": "={{ $json.action_type }}",
              "rightValue": "attack",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        }
      },
