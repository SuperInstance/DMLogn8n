# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dmlogn8n_trading
DB_USER=postgres
DB_PASSWORD=password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d

# External API Configuration
N8N_WEBHOOK_URL=http://localhost:5678/webhook
DMLOGN8N_API_URL=http://localhost:3000/api

# Economic Configuration
BASE_TAX_RATE=0.05
AUCTION_FEE=0.02
TRADE_FEE=0.01
MARKET_MANIPULATION_THRESHOLD=100000
PRICE_UPDATE_INTERVAL=30000

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/trading.log

# Security
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Features
ENABLE_MARKET_PREDICTIONS=true
ENABLE_BULK_TRADING=true
ENABLE_ANONYMOUS_BIDDING=true