    {
      "parameters": {
        "jsCode": "// Filter out the platform that sent the update\nconst allPlatforms = $input.all();\nconst syncMessage = $('Parse Sync Message').first().json;\nconst updatedBy = syncMessage.updated_by; // Format: \"platform:device_id\"\n\nconst [updatingPlatform] = updatedBy.split(':');\n\nconst otherPlatforms = allPlatforms\n  .filter(item => {\n    const platform = item.json.platform;\n    return platform !== updatingPlatform;\n  })\n  .map(item => ({\n    json: {\n      ...item.json,\n      needs_notification: true\n    }\n  }));\n\nreturn otherPlatforms.length > 0 ? otherPlatforms : [{\n  json: {\n    message: 'No other platforms to notify',\n    updating_platform: updatingPlatform\n  }\n}];"
      },
      "id": "filter-notification-targets",
      "name": "Filter Notification Targets",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "needs-notification",
              "leftValue": "={{ $json.needs_notification }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equal"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-needs-notification",
      "name": "Check Needs Notification",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        2000,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Prepare personalized notification for each platform\nconst platformData = $json;\nconst syncMessage = $('Parse Sync Message').first().json;\nconst saveGameDetails = $('Get Save Game Details').first().json;\n\nconst notification = {\n  type: 'real_time_sync_update',\n  save_game_id: syncMessage.save_game_id,\n  campaign_name: saveGameDetails.campaign_name,\n  character_name: saveGameDetails.character_name,\n  version: syncMessage.version,\n  updated_by: syncMessage.updated_by,\n  timestamp: syncMessage.timestamp,\n  target_platform: platformData.platform,\n  target_device_id: platformData.device_id,\n  target_device_name: platformData.device_name,\n  current_version: platformData.sync_version,\n  needs_sync: platformData.sync_version < syncMessage.version,\n  message: `Your save game \"${saveGameDetails.campaign_name}\" has been updated to version ${syncMessage.version}`\n};\n\nreturn [{\n  json: notification\n}];"
      },
      "id": "prepare-platform-notification",
      "name": "Prepare Platform Notification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2220,
        300
      ]
    },
    {
      "parameters": {
        "operation": "select",
        "table": "ws_sessions",
        "where": {
          "conditions": [
            {
              "id": "active-sessions",
              "condition": "user_id",
              "operation": "equal",
              "value": "={{ $json.user_id }}"
            },
            {
              "id": "matching-platform",
              "condition": "platform",
              "operation": "equal",
              "value": "={{ $json.target_platform }}"
            },
            {
              "id": "session-active",
              "condition": "is_active",
              "operation": "equal",
              "value": true
            }
          ],
          "combinator": "and"
        },
        "additionalFields": {
          "returnFields": "session_id, device_id, last_ping, subscriptions"
        }
      },
      "id": "get-active-sessions",
      "name": "Get Active Sessions",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [
        2440,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "dmlogn8n-postgres-credentials",
          "name": "DMlogn8n PostgreSQL"
