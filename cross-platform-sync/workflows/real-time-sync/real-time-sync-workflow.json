    {
      "parameters": {
        "jsCode": "// Send WebSocket notifications to active sessions\nconst notificationData = $('Prepare Platform Notification').first().json;\nconst sessions = $input.all();\nconst results = [];\n\nfor (const session of sessions) {\n  const sessionData = session.json;\n  \n  // Check if session is subscribed to this save game\n  const subscriptions = sessionData.subscriptions ? JSON.parse(sessionData.subscriptions) : [];\n  const isSubscribed = subscriptions.includes(notificationData.save_game_id);\n  \n  if (isSubscribed || !subscriptions.length) { // Send if subscribed or no specific subscriptions\n    const notification = {\n      ...notificationData,\n      session_id: sessionData.session_id,\n      device_id: sessionData.device_id,\n      last_ping: sessionData.last_ping,\n      delivery_method: 'websocket'\n    };\n    \n    results.push({\n      json: notification\n    });\n  }\n}\n\nreturn results.length > 0 ? results : [{\n  json: {\n    message: 'No active sessions to notify',\n    save_game_id: notificationData.save_game_id,\n    target_platform: notificationData.target_platform\n  }\n}];"
      },
      "id": "prepare-websocket-notifications",
      "name": "Prepare WebSocket Notifications",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2880,
        300
      ]
    },
