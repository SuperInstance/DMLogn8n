    {
      "parameters": {
        "url": "={{ $json.platform_type === 'ios' ? 'https://api.push.apple.com/3/device' : 'https://fcm.googleapis.com/fcm/send' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "bearer {{ $json.platform_type === 'ios' ? $credentials.APNS_AUTH_TOKEN : $credentials.FCM_SERVER_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.platform_type === 'ios' ? {\n  \"aps\": {\n    \"alert\": {\n      \"title\": $json.title,\n      \"body\": $json.body\n    },\n    \"badge\": 1,\n    \"sound\": \"default\",\n    \"priority\": $json.priority === 'high' ? 10 : 5\n  },\n  \"data\": $json.data\n} : {\n  \"to\": $json.token,\n  \"notification\": {\n    \"title\": $json.title,\n    \"body\": $json.body,\n    \"sound\": \"default\"\n  },\n  \"data\": $json.data,\n  \"priority\": $json.priority === 'high' ? 'high' : 'normal'\n}}}",
        "options": {
          "timeout": 10000
        }
      },
