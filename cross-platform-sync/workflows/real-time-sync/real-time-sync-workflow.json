    {
      "parameters": {
        "jsCode": "// Prepare push notifications for offline devices\nconst platformData = $('Filter Notification Targets').first().json;\nconst syncMessage = $('Parse Sync Message').first().json;\nconst saveGameDetails = $('Get Save Game Details').first().json;\n\nif (platformData.message === 'No other platforms to notify') {\n  return [{\n    json: {\n      message: 'No push notifications needed'\n    }\n  }];\n}\n\nconst pushNotification = {\n  type: 'sync_update_push',\n  user_id: saveGameDetails.user_id,\n  platform: platformData.platform,\n  device_id: platformData.device_id,\n  title: 'Save Game Updated',\n  body: `\"${saveGameDetails.campaign_name}\" has been updated to version ${syncMessage.version}`,\n  data: {\n    save_game_id: syncMessage.save_game_id,\n    campaign_name: saveGameDetails.campaign_name,\n    version: syncMessage.version,\n    updated_by: syncMessage.updated_by,\n    needs_sync: platformData.sync_version < syncMessage.version\n  },\n  priority: platformData.sync_version < syncMessage.version ? 'high' : 'normal',\n  timestamp: new Date().toISOString()\n};\n\nreturn [{\n  json: pushNotification\n}];"
      },
      "id": "prepare-push-notifications",
      "name": "Prepare Push Notifications",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2220,
        420
      ]
    },
