    {
      "parameters": {
        "jsCode": "// Log error and continue processing\nconst errorData = $input.first().json;\n\nconsole.error('Real-time sync error:', errorData);\n\n// Log error to database\nawait require('pg').Pool({\n  host: process.env.DB_HOST,\n  port: process.env.DB_PORT,\n  database: process.env.DB_NAME,\n  user: process.env.DB_USER,\n  password: process.env.DB_PASSWORD\n}).query(`\n  INSERT INTO sync_errors (id, error_type, error_message, raw_data, created_at)\n  VALUES ($1, $2, $3, $4, NOW())\n`, [\n  require('crypto').randomUUID(),\n  'real_time_sync_error',\n  errorData.error || 'Unknown error',\n  JSON.stringify(errorData)\n]);\n\nreturn [{\n  json: {\n    error_handled: true,\n    error_type: 'real_time_sync_error',\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "handle-error",
      "name": "Handle Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        420
      ]
    },
    {
      "parameters": {
        "jsCode": "// Clean up old notifications and update metrics\nconst cleanupData = {\n  execution_time: new Date().toISOString(),\n  notifications_processed: $('Send WebSocket Notifications').all().length + $('Send Push Notifications').all().length,\n  websocket_sent: $('Send WebSocket Notifications').all().length,\n  push_sent: $('Send Push Notifications').all().length\n};\n\n// Clean up notifications older than 7 days\nconst cleanupQuery = `\n  DELETE FROM sync_notifications \n  WHERE sent_at < NOW() - INTERVAL '7 days'\n`;\n\n// Update Redis metrics\nconst redis = require('ioredis');\nconst redisClient = new redis({\n  host: 'localhost',\n  port: 6379,\n  password: process.env.REDIS_PASSWORD\n});\n\nredisClient.hmset('real_time_sync_stats', {\n  last_execution: cleanupData.execution_time,\n  notifications_processed: cleanupData.notifications_processed,\n  websocket_sent: cleanupData.websocket_sent,\n  push_sent: cleanupData.push_sent\n});\n\nredisClient.expire('real_time_sync_stats', 86400); // 24 hours\n\nredisClient.quit();\n\nconsole.log('Real-time sync workflow completed:', cleanupData);\n\nreturn [{\n  json: {\n    workflow: 'real-time-sync',\n    cleanup_data: cleanupData,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "cleanup-and-metrics",
      "name": "Cleanup and Metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3540,
        300
      ]
    }
  ],
