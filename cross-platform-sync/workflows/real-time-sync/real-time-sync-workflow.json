{
  "name": "DMlogn8n Real-Time Sync Workflow",
  "nodes": [
    {
      "parameters": {
        "channel": "sync:save:*",
        "options": {}
      },
      "id": "redis-sync-trigger",
      "name": "Redis Sync Trigger",
      "type": "n8n-nodes-base.redisTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "credentials": {
        "redis": {
          "id": "dmlogn8n-redis-credentials",
          "name": "DMlogn8n Redis"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse Redis sync message\nconst redisMessage = $input.first().json;\n\ntry {\n  const syncData = JSON.parse(redisMessage.message);\n  const channel = redisMessage.channel;\n  \n  // Extract save game ID from channel\n  const saveGameId = channel.split(':')[2];\n  \n  const processedData = {\n    save_game_id: saveGameId,\n    type: syncData.type,\n    version: syncData.version,\n    updated_by: syncData.updatedBy,\n    timestamp: syncData.timestamp,\n    channel: channel,\n    original_message: syncData\n  };\n  \n  return [{\n    json: processedData\n  }];\n} catch (error) {\n  console.error('Failed to parse Redis message:', error);\n  return [{\n    json: {\n      error: error.message,\n      raw_message: redisMessage\n    }\n  }];\n}"
      },
      "id": "parse-sync-message",
      "name": "Parse Sync Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "valid-sync-message",
              "leftValue": "={{ $json.error }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists"
              },
              "negate": true
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "validate-sync-message",
      "name": "Validate Sync Message",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
