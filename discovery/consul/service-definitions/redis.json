{
  "service": {
    "name": "redis",
    "id": "redis-1",
    "tags": [
      "cache",
      "redis",
      "dmlogn8n",
      "primary",
      "version:7"
    ],
    "address": "redis.dmlogn8n.local",
    "port": 6379,
    "meta": {
      "service_id": "redis-1",
      "service_type": "cache",
      "version": "7.0",
      "owner": "data-team",
      "team": "data",
      "environment": "production",
      "region": "us-east-1",
