      "cache_type": "redis",
      "role": "primary",
      "memory_limit": "8GB"
    },
    "enable_tag_override": false,
    "check": {
      "id": "redis-health",
      "name": "Redis Health Check",
      "tcp": "redis.dmlogn8n.local:6379",
      "interval": "5s",
      "timeout": "2s",
      "deregister_critical_service_after": "30s"
    }
  }
}