              "quantity": "={{$json.request.quantity}}",
              "status": "={{$json.bestDonor ? 'fulfilled' : 'failed'}}",
              "donorGuildId": "={{$json.bestDonor ? $json.bestDonor.guildId : null}}",
              "processedAt": "{{new Date().toISOString()}}"
            }
          },
          "position": [1650, 50]
        }
