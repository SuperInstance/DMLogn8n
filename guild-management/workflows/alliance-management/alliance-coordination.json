              "fromGuildId": "={{$json.bestDonor.guildId}}",
              "toGuildId": "={{$json.request.requestingGuildId}}",
              "resourceType": "={{$json.request.resourceType}}",
              "quantity": "={{$json.request.quantity}}",
              "transferType": "alliance_sharing",
              "initiatedBy": "system_auto"
            },
            "headers": {
