{
  "name": "dmlogn8n-multiplayer-arena",
  "version": "1.0.0",
  "description": "Advanced Multiplayer Arena System for DMlogn8n - Competitive D&D gameplay with matchmaking, spectating, rankings, and tournaments",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --coverage",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:performance": "jest --testPathPattern=tests/performance",
    "test:anticheat": "jest --testPathPattern=tests/anticheat",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write src/**/*.js",
    "docs": "jsdoc -c jsdoc.conf.json",
    "build": "webpack --mode production",
    "import-workflows": "node scripts/import-workflows.js",
    "setup": "npm install && npm run import-workflows",
    "monitor": "node scripts/monitor.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js"
  },
  "keywords": [
    "dnd",
    "dungeons-and-dragons",
    "multiplayer",
    "arena",
    "competitive",
    "matchmaking",
    "spectating",
    "tournaments",
    "ranking",
    "anticheat",
    "netcode",
    "real-time",
    "gaming"
  ],
  "author": "DMlogn8n Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dmlogn8n/multiplayer-arena.git"
  },
  "bugs": {
    "url": "https://github.com/dmlogn8n/multiplayer-arena/issues"
  },
  "homepage": "https://dmlogn8n.com/multiplayer-arena",
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "mongodb": "^5.7.0",
    "redis": "^4.6.7",
    "mongoose": "^7.4.0",
    "ws": "^8.13.0",
    "node-cron": "^3.0.2",
    "helmet": "^7.0.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^6.8.1",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "winston": "^3.10.0",
    "dotenv": "^16.3.1",
    "joi": "^17.9.2",
    "bcrypt": "^5.1.0",
    "jsonwebtoken": "^9.0.1",
    "uuid": "^9.0.0",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "ml-matrix": "^6.10.4",
    "tensor": "^0.4.5",
    "node-cron": "^3.0.2",
    "bull": "^4.11.3",
    "ioredis": "^5.3.2",
    "amqplib": "^0.10.3",
    "nodemailer": "^6.9.4",
    "sharp": "^0.32.4",
    "fluent-ffmpeg": "^2.1.2",
    "node-opus": "^0.3.3",
    "sodium-native": "^4.0.1",
    "lz4": "^0.6.5",
    "snappy": "^7.2.2",
    "protobufjs": "^7.2.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.6.1",
    "supertest": "^6.3.3",
    "eslint": "^8.45.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "prettier": "^3.0.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.3",
    "jsdoc": "^4.0.2",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "babel-loader": "^9.1.2",
    "@babel/core": "^7.22.9",
    "@babel/preset-env": "^7.22.9",
    "nyc": "^15.1.0",
    "benchmark": "^2.1.4",
    "clinic": "^12.1.0",
    "autocannon": "^7.12.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm test",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write",
      "git add"
    ]
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/index.js",
      "!**/node_modules/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ]
  },
  "nyc": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "**/tests/**",
      "**/node_modules/**"
    ]
  }
}